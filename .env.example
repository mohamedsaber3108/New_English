NODE_ENV=production
PORT=4100
SITE_ORIGIN=https://language.example.com
# --- Database (relational tables; schema migrations run automatically at startup) ---
# Production / any multi-instance deployment: PostgreSQL 16+.
# DATABASE_URL=postgres://user:password@host:5432/usam
# PGSSL=require                    # when the provider requires TLS (most managed Postgres, e.g. RDS)
# PGSSL_REJECT_UNAUTHORIZED=true   # keep true; set false only for providers whose CA you cannot install
# PG_POOL_MAX=10                   # pooled connections per app instance (instances x pool <= DB max_connections)
# PG_CONNECT_TIMEOUT_MS=8000
# Without DATABASE_URL: embedded PostgreSQL (PGlite) in a local directory - single process only (dev/staging).
# PGLITE_DATA_DIR=/var/lib/usam-language/pglite
# Legacy single-document store: if this JSON file (or an old app_state table in DATABASE_URL) exists when the
# tables are empty, it is imported once automatically at first start. Default PGlite dir is derived from it.
CUSTOMER_DB_FILE=/var/lib/usam-language/customers.json
# Legacy leads file, imported once into the leads table when the admin console first lists leads.
LEADS_FILE=/var/lib/usam-language/leads.jsonl
# --- Administration ---
# Admins sign in with individual accounts (roles: owner, admin, finance, support, viewer).
# Create the first owner with:  ADMIN_PASSWORD='...' npm run admin:create -- --email you@domain --name "Your Name" --role owner
# ADMIN_SESSION_MS=28800000      # absolute admin session lifetime (8h)
# ADMIN_IDLE_MS=1800000          # admin idle timeout (30 min)
# Two-factor authentication (TOTP) for administrators. ADMIN_MFA_KEY encrypts TOTP secrets at rest (AES-256-GCM);
# without it MFA enrollment is refused. Generate like AUDIT_HMAC_KEY and keep it out of the database.
ADMIN_MFA_KEY=
# When true, admins without MFA can sign in but can only enroll until MFA is on. Recommended for production.
ADMIN_REQUIRE_MFA=true
# Legacy shared token: DISABLED by default. During migration only, set ADMIN_LEGACY_TOKEN=true to allow it
# read-only (every use is audited). Remove both once named admins exist.
# ADMIN_LEGACY_TOKEN=false
# ADMIN_ACCESS_TOKEN=
# --- Audit log ---
# Secret key that signs the tamper-evident audit chain. Keep it OUT of the database and backups of the database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_HMAC_KEY=
# After rotating AUDIT_HMAC_KEY, list the old key(s) here (comma-separated) so history still verifies.
# AUDIT_HMAC_PREVIOUS_KEYS=
# AUDIT_MAX_ENTRIES=5000         # entries kept in the hot store (older ones are trimmed with a verification anchor)
REQUIRE_VERIFIED_EMAIL=true
# --- Observability ---
# JSON logs on stdout/stderr (journald / CloudWatch agent). debug logs every request; info logs 4xx/5xx only.
LOG_LEVEL=info
# Prometheus metrics at GET /api/metrics with "Authorization: Bearer <token>". Endpoint is disabled when unset.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
METRICS_TOKEN=
# Access enforcement for paid learning content. Decoupled from payment configuration (fail closed).
#   enforced -> always require a valid entitlement (recommended for any public deployment)
#   auto     -> same as enforced (default); the absence of Paymob keys NEVER opens paid content
#   open     -> serve learning content to everyone WITHOUT an entitlement (intentional free/preview deployments only)
ACCESS_ENFORCEMENT=enforced
RESEND_API_KEY=
EMAIL_FROM=USAM Language <language@example.com>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_IDS=
PAYMOB_HMAC_SECRET=
