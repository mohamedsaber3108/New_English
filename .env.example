NODE_ENV=production
PORT=4100
SITE_ORIGIN=https://language.example.com
CUSTOMER_DB_FILE=/var/lib/usam-language/customers.json
LEADS_FILE=/var/lib/usam-language/leads.jsonl
# Storage backend. Leave DATABASE_URL empty to use the single-file JSON store (dev/staging/single-instance).
# Set DATABASE_URL to use PostgreSQL (durable, pooled, survives restarts, shared across instances).
# DATABASE_URL=postgres://user:password@host:5432/usam
# PGSSL=require           # set when the provider requires TLS (most managed Postgres)
# PG_POOL_MAX=10          # max pooled connections per app instance
# PG_CONNECT_TIMEOUT_MS=8000
ADMIN_ACCESS_TOKEN=replace-with-at-least-32-random-characters
REQUIRE_VERIFIED_EMAIL=true
# Access enforcement for paid learning content. Decoupled from payment configuration (fail closed).
#   enforced -> always require a valid entitlement (recommended for any public deployment)
#   auto     -> same as enforced (default); the absence of Paymob keys NEVER opens paid content
#   open     -> serve learning content to everyone WITHOUT an entitlement (intentional free/preview deployments only)
ACCESS_ENFORCEMENT=enforced
RESEND_API_KEY=
EMAIL_FROM=USAM Language <language@example.com>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_IDS=
PAYMOB_HMAC_SECRET=
