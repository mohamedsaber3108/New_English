[Unit]
Description=USAM Language PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=usam-language
Group=usam-language
WorkingDirectory=/opt/usam-language/current
# Needs DATABASE_URL; optional BACKUP_DIR, BACKUP_RETENTION_DAYS, BACKUP_S3_URI (requires the AWS CLI and an
# instance role allowing s3:PutObject on that prefix).
EnvironmentFile=/etc/usam-language.env
ExecStart=/opt/usam-language/current/scripts/backup.sh /var/backups/usam-language
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/usam-language
# /var/lib/usam-language/backup-status.json (written by backup.sh, read by the admin console). Keep this value
# in sync with BACKUP_STATUS_FILE if you change it in /etc/usam-language.env.
StateDirectory=usam-language
StateDirectoryMode=0755
