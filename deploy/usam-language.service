[Unit]
Description=USAM Language web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=usam-language
Group=usam-language
WorkingDirectory=/opt/usam-language
EnvironmentFile=/etc/usam-language.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/usam-language

[Install]
WantedBy=multi-user.target
